{
  "tab_size": 2,
  "translate_tabs_to_spaces": true,
  "detect_indentation": false,
  "auto_indent": true,
  "smart_indent": true,
  "trim_trailing_white_space_on_save": true,
  "ensure_newline_at_eof_on_save": true,
  "line_comment": "//",
  "increase_indent_pattern": "^.*\\{[^}]*$",
  "decrease_indent_pattern": "^\\s*\\}",
  "indent_to_bracket": false
}
